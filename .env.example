PORT=3000

# Option 1: separate MySQL variables
DB_HOST=your_database_host
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=replace_with_a_new_strong_password

# Option 2: single MySQL connection string
# DATABASE_URL="mysql://user:password@host:3306/database"

JWT_SECRET=replace_with_a_long_random_secret

AUTH_ADMIN_NAME="Administrador WAYRA TRAIL"
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_EMAIL=admin@wayratrail.com
AUTH_ADMIN_PASSWORD=replace_with_a_new_strong_password
AUTH_ADMIN_ROLE=admin
